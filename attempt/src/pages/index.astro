---
const title = "cua mic diagnostics";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main class="shell">
      <section class="panel">
        <div class="topline">
          <div>
            <p class="eyebrow">cua mic lab</p>
            <h1>MacBook microphone diagnostics</h1>
          </div>
          <div id="state" class="pill">idle</div>
        </div>

        <div class="controls">
          <label>
            Input
            <select id="deviceSelect"></select>
          </label>
          <button id="refreshBtn" type="button">Refresh</button>
          <button id="startBtn" type="button">Record run</button>
          <button id="stopBtn" type="button" disabled>Stop</button>
        </div>

        <div class="meters" aria-label="Live levels">
          <div class="meter">
            <span>RMS</span>
            <strong id="rmsText">0.000000</strong>
            <div><i id="rmsBar"></i></div>
          </div>
          <div class="meter">
            <span>Peak</span>
            <strong id="peakText">0.000000</strong>
            <div><i id="peakBar"></i></div>
          </div>
          <div class="meter">
            <span>dBFS</span>
            <strong id="dbText">-inf</strong>
            <div><i id="dbBar"></i></div>
          </div>
        </div>

        <div class="grid">
          <article>
            <span>Device label</span>
            <strong id="labelText">unknown</strong>
          </article>
          <article>
            <span>Track settings</span>
            <strong id="settingsText">not started</strong>
          </article>
          <article>
            <span>Recording</span>
            <strong id="recordingText">0 ms</strong>
          </article>
          <article>
            <span>Mean RMS</span>
            <strong id="meanText">0.000000</strong>
          </article>
          <article>
            <span>Noise floor</span>
            <strong id="floorText">0.000000</strong>
          </article>
          <article>
            <span>Speech windows</span>
            <strong id="speechText">0</strong>
          </article>
          <article>
            <span>Clipped frames</span>
            <strong id="clippedText">0</strong>
          </article>
          <article>
            <span>Frames</span>
            <strong id="framesText">0</strong>
          </article>
          <article>
            <span>Session runs</span>
            <strong id="runsText">0</strong>
          </article>
        </div>

        <div class="actions">
          <button id="exportSessionBtn" type="button" disabled>Export session JSON</button>
          <button id="copySessionBtn" type="button" disabled>Copy JSON</button>
          <button id="clearRunsBtn" type="button" disabled>Clear runs</button>
        </div>

        <section class="runs" aria-label="Recorded diagnostic runs">
          <div class="section-title">
            <span>Runs</span>
            <strong id="sessionSummary">No recordings yet</strong>
          </div>
          <div id="runsList" class="runs-list"></div>
        </section>

        <section class="cua-panel" aria-label="CUA ingestion results">
          <div class="section-title">
            <span>CUA ingestion</span>
            <strong id="cuaSummary">No CUA runs yet</strong>
          </div>
          <div id="cuaResults" class="cua-results"></div>
        </section>

        <pre id="log" aria-live="polite"></pre>
      </section>
    </main>

    <script>
      // @ts-nocheck
      const els = {
        state: document.querySelector("#state"),
        deviceSelect: document.querySelector("#deviceSelect"),
        refreshBtn: document.querySelector("#refreshBtn"),
        startBtn: document.querySelector("#startBtn"),
        stopBtn: document.querySelector("#stopBtn"),
        exportSessionBtn: document.querySelector("#exportSessionBtn"),
        copySessionBtn: document.querySelector("#copySessionBtn"),
        clearRunsBtn: document.querySelector("#clearRunsBtn"),
        rmsText: document.querySelector("#rmsText"),
        peakText: document.querySelector("#peakText"),
        dbText: document.querySelector("#dbText"),
        rmsBar: document.querySelector("#rmsBar"),
        peakBar: document.querySelector("#peakBar"),
        dbBar: document.querySelector("#dbBar"),
        labelText: document.querySelector("#labelText"),
        settingsText: document.querySelector("#settingsText"),
        recordingText: document.querySelector("#recordingText"),
        meanText: document.querySelector("#meanText"),
        floorText: document.querySelector("#floorText"),
        speechText: document.querySelector("#speechText"),
        clippedText: document.querySelector("#clippedText"),
        framesText: document.querySelector("#framesText"),
        runsText: document.querySelector("#runsText"),
        sessionSummary: document.querySelector("#sessionSummary"),
        runsList: document.querySelector("#runsList"),
        cuaSummary: document.querySelector("#cuaSummary"),
        cuaResults: document.querySelector("#cuaResults"),
        log: document.querySelector("#log"),
      };

      const session = {
        schema: "cua.mic_diagnostics.session.v1",
        createdAt: new Date().toISOString(),
        userAgent: navigator.userAgent,
        platform: navigator.platform,
        runs: [],
      };

      let stream;
      let context;
      let analyser;
      let source;
      let processor;
      let silentGain;
      let recorder;
      let chunks = [];
      let pcmChunks = [];
      let raf = 0;
      let stats = resetStats();

      function resetStats() {
        return {
          id: crypto.randomUUID(),
          startedAtIso: "",
          stoppedAtIso: "",
          startedAtMs: 0,
          stoppedAtMs: 0,
          frames: 0,
          clippedFrames: 0,
          zeroCrossingSum: 0,
          peak: 0,
          maxRms: 0,
          rmsSum: 0,
          dbSum: 0,
          dbCount: 0,
          floor: Number.POSITIVE_INFINITY,
          speechLikeFrames: 0,
          longestSpeechLikeMs: 0,
          currentSpeechLikeMs: 0,
          samplesPerFrame: 0,
          captureSampleRate: 0,
          pcmFrameCount: 0,
          deviceLabel: "",
          settings: {},
          constraints: {},
          capabilities: {},
          mimeType: "",
          timeline: [],
          rmsSamples: [],
          peakSamples: [],
          dbSamples: [],
        };
      }

      function setState(text) {
        els.state.textContent = text;
      }

      function log(message) {
        const time = new Date().toLocaleTimeString();
        els.log.textContent = `[${time}] ${message}\n${els.log.textContent}`.slice(0, 9000);
      }

      async function loadDevices() {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const inputs = devices.filter((device) => device.kind === "audioinput");
        els.deviceSelect.replaceChildren();
        for (const input of inputs) {
          const option = document.createElement("option");
          option.value = input.deviceId;
          option.textContent = input.label || `Microphone ${els.deviceSelect.length + 1}`;
          if ((input.label || "").toLowerCase().includes("macbook")) option.selected = true;
          els.deviceSelect.append(option);
        }
        log(`Found ${inputs.length} audio input device(s).`);
      }

      async function start() {
        await stop(false);
        setState("requesting");
        const selectedId = els.deviceSelect.value;
        const constraints = {
          audio: {
            deviceId: selectedId ? { exact: selectedId } : undefined,
            echoCancellation: false,
            noiseSuppression: false,
            autoGainControl: false,
            channelCount: { ideal: 1 },
          },
        };

        stream = await navigator.mediaDevices.getUserMedia(constraints);
        await loadDevices();

        const track = stream.getAudioTracks()[0];
        stats = resetStats();
        stats.startedAtIso = new Date().toISOString();
        stats.startedAtMs = performance.now();
        stats.deviceLabel = track.label;
        stats.settings = safeCall(() => track.getSettings(), {});
        stats.constraints = safeCall(() => track.getConstraints(), {});
        stats.capabilities = safeCall(() => track.getCapabilities(), {});

        els.labelText.textContent = track.label || "unknown";
        els.settingsText.textContent = compactSettings(stats.settings);

        context = new AudioContext({ latencyHint: "interactive" });
        source = context.createMediaStreamSource(stream);
        analyser = context.createAnalyser();
        analyser.fftSize = 2048;
        analyser.smoothingTimeConstant = 0.08;
        source.connect(analyser);
        processor = context.createScriptProcessor(4096, 1, 1);
        silentGain = context.createGain();
        silentGain.gain.value = 0;
        stats.captureSampleRate = context.sampleRate;
        pcmChunks = [];
        processor.onaudioprocess = (event) => {
          const input = event.inputBuffer.getChannelData(0);
          pcmChunks.push(new Float32Array(input));
          stats.pcmFrameCount += input.length;
        };
        source.connect(processor);
        processor.connect(silentGain);
        silentGain.connect(context.destination);

        chunks = [];
        const mimeType = pickMimeType();
        recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
        stats.mimeType = recorder.mimeType;
        recorder.ondataavailable = (event) => {
          if (event.data.size > 0) chunks.push(event.data);
        };
        recorder.onstop = () => finalizeRecording();
        recorder.start(100);

        els.startBtn.disabled = true;
        els.stopBtn.disabled = false;
        els.exportSessionBtn.disabled = true;
        els.copySessionBtn.disabled = true;
        setState("recording");
        tick();
        log(`Recording run ${session.runs.length + 1}: ${track.label || "selected microphone"}.`);
      }

      async function stop(announce = true) {
        cancelAnimationFrame(raf);
        raf = 0;
        if (recorder && recorder.state !== "inactive") recorder.stop();
        if (processor) processor.disconnect();
        if (silentGain) silentGain.disconnect();
        if (stream) stream.getTracks().forEach((track) => track.stop());
        if (context && context.state !== "closed") await context.close();
        stream = undefined;
        context = undefined;
        analyser = undefined;
        source = undefined;
        processor = undefined;
        silentGain = undefined;
        els.startBtn.disabled = false;
        els.stopBtn.disabled = true;
        if (announce) {
          stats.stoppedAtMs = performance.now();
          stats.stoppedAtIso = new Date().toISOString();
          setState("stopped");
          log("Stopped recording.");
        }
      }

      function tick() {
        if (!analyser) return;
        const data = new Float32Array(analyser.fftSize);
        analyser.getFloatTimeDomainData(data);

        let sumSquares = 0;
        let peak = 0;
        let crossings = 0;
        let lastSign = Math.sign(data[0]);
        for (const sample of data) {
          const magnitude = Math.abs(sample);
          peak = Math.max(peak, magnitude);
          sumSquares += sample * sample;
          const sign = Math.sign(sample);
          if (sign !== 0 && lastSign !== 0 && sign !== lastSign) crossings += 1;
          if (sign !== 0) lastSign = sign;
        }

        const rms = Math.sqrt(sumSquares / data.length);
        const db = rms > 0 ? 20 * Math.log10(rms) : -Infinity;
        const elapsed = performance.now() - stats.startedAtMs;
        const frameMs = (data.length / (stats.settings.sampleRate || context.sampleRate)) * 1000;
        const speechLike = rms > 0.003 || peak > 0.035;

        stats.frames += 1;
        stats.samplesPerFrame = data.length;
        stats.peak = Math.max(stats.peak, peak);
        stats.maxRms = Math.max(stats.maxRms, rms);
        stats.rmsSum += rms;
        stats.zeroCrossingSum += crossings / data.length;
        if (Number.isFinite(db)) {
          stats.dbSum += db;
          stats.dbCount += 1;
        }
        if (rms > 0) stats.floor = Math.min(stats.floor, rms);
        if (peak >= 0.98) stats.clippedFrames += 1;
        if (speechLike) {
          stats.speechLikeFrames += 1;
          stats.currentSpeechLikeMs += frameMs;
          stats.longestSpeechLikeMs = Math.max(stats.longestSpeechLikeMs, stats.currentSpeechLikeMs);
        } else {
          stats.currentSpeechLikeMs = 0;
        }

        stats.rmsSamples.push(rms);
        stats.peakSamples.push(peak);
        if (Number.isFinite(db)) stats.dbSamples.push(db);
        if (stats.frames % 4 === 0) {
          stats.timeline.push({
            ms: Math.round(elapsed),
            rms: round(rms),
            peak: round(peak),
            dbfs: Number.isFinite(db) ? round(db) : null,
            zeroCrossingRate: round(crossings / data.length),
            speechLike,
          });
        }

        renderMeter(rms, peak, db, elapsed);
        raf = requestAnimationFrame(tick);
      }

      function renderMeter(rms, peak, db, elapsed) {
        els.rmsText.textContent = round(rms).toFixed(6);
        els.peakText.textContent = round(peak).toFixed(6);
        els.dbText.textContent = Number.isFinite(db) ? `${round(db).toFixed(1)} dB` : "-inf";
        els.rmsBar.style.width = `${Math.min(100, rms * 1100)}%`;
        els.peakBar.style.width = `${Math.min(100, peak * 100)}%`;
        els.dbBar.style.width = `${Math.min(100, Math.max(0, db + 80) * 1.25)}%`;
        els.framesText.textContent = String(stats.frames);
        els.meanText.textContent = round(stats.rmsSum / Math.max(1, stats.frames)).toFixed(6);
        els.floorText.textContent = Number.isFinite(stats.floor) ? round(stats.floor).toFixed(6) : "0.000000";
        els.speechText.textContent = String(stats.speechLikeFrames);
        els.clippedText.textContent = String(stats.clippedFrames);
        els.recordingText.textContent = `${Math.round(elapsed)} ms`;
      }

      function finalizeRecording() {
        const audioBlob = new Blob(chunks, { type: stats.mimeType || "audio/webm" });
        const wavBlob = encodeWavFromFloatChunks(pcmChunks, stats.captureSampleRate || stats.settings.sampleRate || 48000);
        const durationMs = Math.round((stats.stoppedAtMs || performance.now()) - stats.startedAtMs);
        const report = {
          schema: "cua.mic_diagnostics.run.v1",
          id: stats.id,
          index: session.runs.length + 1,
          startedAt: stats.startedAtIso,
          stoppedAt: stats.stoppedAtIso || new Date().toISOString(),
          durationMs,
          userAgent: navigator.userAgent,
          platform: navigator.platform,
          deviceLabel: stats.deviceLabel,
          settings: stats.settings,
          constraints: stats.constraints,
          capabilities: stats.capabilities,
          frames: stats.frames,
          samplesPerFrame: stats.samplesPerFrame,
          captureSampleRate: stats.captureSampleRate || stats.settings.sampleRate || 48000,
          pcmFrameCount: stats.pcmFrameCount,
          peak: round(stats.peak),
          maxRms: round(stats.maxRms),
          meanRms: round(stats.rmsSum / Math.max(1, stats.frames)),
          p50Rms: round(percentile(stats.rmsSamples, 0.5)),
          p90Rms: round(percentile(stats.rmsSamples, 0.9)),
          p99Rms: round(percentile(stats.rmsSamples, 0.99)),
          noiseFloorRms: Number.isFinite(stats.floor) ? round(stats.floor) : 0,
          meanDbfs: stats.dbCount ? round(stats.dbSum / stats.dbCount) : null,
          p90Dbfs: roundOrNull(percentile(stats.dbSamples, 0.9)),
          p99Peak: round(percentile(stats.peakSamples, 0.99)),
          clippedFrames: stats.clippedFrames,
          zeroCrossingRateMean: round(stats.zeroCrossingSum / Math.max(1, stats.frames)),
          speechLikeFrames: stats.speechLikeFrames,
          speechLikeRatio: round(stats.speechLikeFrames / Math.max(1, stats.frames)),
          longestSpeechLikeMs: Math.round(stats.longestSpeechLikeMs),
          mimeType: stats.mimeType,
          audioBytes: audioBlob.size,
          wavBytes: wavBlob.size,
          timeline: stats.timeline,
        };

        const run = { report, audioBlob, wavBlob, cua: null, cuaStatus: "queued" };
        session.runs.push(run);
        renderRuns();
        runCuaForRun(run).catch((error) => {
          run.cuaStatus = "error";
          run.cua = { ok: false, error: error.message || String(error) };
          renderRuns();
          renderCuaResults();
          log(`CUA run ${report.index} failed: ${error.message || String(error)}.`);
        });
        log(
          `Run ${report.index} ready: peak=${report.peak}, meanRms=${report.meanRms}, p90=${report.p90Rms}, speechLike=${report.speechLikeRatio}.`
        );
      }

      function renderRuns() {
        els.runsText.textContent = String(session.runs.length);
        els.exportSessionBtn.disabled = session.runs.length === 0;
        els.copySessionBtn.disabled = session.runs.length === 0;
        els.clearRunsBtn.disabled = session.runs.length === 0;
        els.sessionSummary.textContent = summarizeSession();
        els.runsList.replaceChildren();

        renderCuaResults();

        for (const run of session.runs.slice().reverse()) {
          const { report, audioBlob, wavBlob } = run;
          const row = document.createElement("article");
          row.className = "run";
          row.innerHTML = `
            <div>
              <span>Run ${report.index}</span>
              <strong>${escapeHtml(report.durationMs)} ms / ${escapeHtml(report.deviceLabel || "unknown")}</strong>
            </div>
            <div>
              <span>mean / p90 / peak</span>
              <strong>${report.meanRms} / ${report.p90Rms} / ${report.peak}</strong>
            </div>
            <div>
              <span>speech / clip</span>
              <strong>${Math.round(report.speechLikeRatio * 100)}% / ${report.clippedFrames}</strong>
            </div>
            <div>
              <span>CUA</span>
              <strong>${escapeHtml(run.cuaStatus || "idle")}</strong>
            </div>
          `;
          const buttons = document.createElement("div");
          buttons.className = "run-actions";
          const audioButton = document.createElement("button");
          audioButton.type = "button";
          audioButton.textContent = "Audio";
          audioButton.addEventListener("click", () => downloadBlob(`cua-mic-run-${report.index}.webm`, audioBlob));
          const jsonButton = document.createElement("button");
          jsonButton.type = "button";
          jsonButton.textContent = "JSON";
          jsonButton.addEventListener("click", () => downloadBlob(`cua-mic-run-${report.index}.json`, jsonBlob(report)));
          const wavButton = document.createElement("button");
          wavButton.type = "button";
          wavButton.textContent = "WAV";
          wavButton.addEventListener("click", () => downloadBlob(`cua-mic-run-${report.index}.wav`, wavBlob));
          const cuaButton = document.createElement("button");
          cuaButton.type = "button";
          cuaButton.textContent = run.cuaStatus === "running" ? "CUA..." : "CUA";
          cuaButton.disabled = run.cuaStatus === "running";
          cuaButton.addEventListener("click", () => runCuaForRun(run));
          buttons.append(audioButton, wavButton, jsonButton, cuaButton);
          row.append(buttons);
          els.runsList.append(row);
        }
      }

      async function runCuaForRun(run) {
        run.cuaStatus = "running";
        renderRuns();
        renderCuaResults();
        log(`Sending run ${run.report.index} WAV into installed CUA.`);
        const startedAt = performance.now();
        const response = await fetch("/api/cua-stt", {
          method: "POST",
          headers: { "content-type": "audio/wav" },
          body: run.wavBlob,
        });
        const result = await response.json();
        run.cuaStatus = result.ok ? "ok" : "error";
        run.cua = {
          ...result,
          browserRoundTripMs: Math.round(performance.now() - startedAt),
        };
        renderRuns();
        renderCuaResults();
        const transcript = result.summary?.transcript || "(no transcript)";
        const error = result.summary?.error ? ` error=${result.summary.error}` : "";
        log(`CUA run ${run.report.index}: ${run.cuaStatus}, transcript=${transcript}.${error}`);
      }

      function renderCuaResults() {
        const completed = session.runs.filter((run) => run.cua).length;
        els.cuaSummary.textContent = completed
          ? `${completed} CUA ingestion result(s)`
          : "No CUA runs yet";
        els.cuaResults.replaceChildren();
        for (const run of session.runs.filter((entry) => entry.cua).slice().reverse()) {
          const result = run.cua;
          const summary = result.summary || {};
          const row = document.createElement("article");
          row.className = "cua-result";
          row.innerHTML = `
            <div>
              <span>Run ${run.report.index} / ${escapeHtml(run.cuaStatus)}</span>
              <strong>${escapeHtml(summary.transcript || summary.error || "no transcript")}</strong>
            </div>
            <div>
              <span>STT</span>
              <strong>${escapeHtml(formatStt(summary.stt))}</strong>
            </div>
            <div>
              <span>timing</span>
              <strong>${escapeHtml(formatMetrics(summary.metrics, result))}</strong>
            </div>
            <pre>${escapeHtml(JSON.stringify(result.events || [], null, 2))}</pre>
          `;
          els.cuaResults.append(row);
        }
      }

      function summarizeSession() {
        if (session.runs.length === 0) return "No recordings yet";
        const reports = session.runs.map((run) => run.report);
        const meanRms = average(reports.map((report) => report.meanRms));
        const p90Rms = average(reports.map((report) => report.p90Rms));
        const peak = Math.max(...reports.map((report) => report.peak));
        return `${reports.length} run(s), avg RMS ${round(meanRms)}, avg p90 ${round(p90Rms)}, max peak ${round(peak)}`;
      }

      function exportableSession() {
        return {
          ...session,
          exportedAt: new Date().toISOString(),
          runs: session.runs.map((run) => ({
            ...run.report,
            cua: run.cua,
          })),
        };
      }

      function encodeWavFromFloatChunks(chunks, sampleRate) {
        const sampleCount = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
        const bytes = new ArrayBuffer(44 + sampleCount * 2);
        const view = new DataView(bytes);
        writeAscii(view, 0, "RIFF");
        view.setUint32(4, 36 + sampleCount * 2, true);
        writeAscii(view, 8, "WAVE");
        writeAscii(view, 12, "fmt ");
        view.setUint32(16, 16, true);
        view.setUint16(20, 1, true);
        view.setUint16(22, 1, true);
        view.setUint32(24, sampleRate, true);
        view.setUint32(28, sampleRate * 2, true);
        view.setUint16(32, 2, true);
        view.setUint16(34, 16, true);
        writeAscii(view, 36, "data");
        view.setUint32(40, sampleCount * 2, true);
        let offset = 44;
        for (const chunk of chunks) {
          for (const sample of chunk) {
            const clamped = Math.max(-1, Math.min(1, sample));
            view.setInt16(offset, clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff, true);
            offset += 2;
          }
        }
        return new Blob([bytes], { type: "audio/wav" });
      }

      function writeAscii(view, offset, text) {
        for (let index = 0; index < text.length; index += 1) {
          view.setUint8(offset + index, text.charCodeAt(index));
        }
      }

      function formatStt(stt) {
        if (!stt) return "none";
        return [stt.backend, stt.model, stt.transcript_class].filter(Boolean).join(" / ");
      }

      function formatMetrics(metrics, result) {
        const values = metrics || {};
        return [
          result.durationMs ? `api ${result.durationMs}ms` : null,
          result.browserRoundTripMs ? `round ${result.browserRoundTripMs}ms` : null,
          values.stt_preflight_overlap_ms ? `stt ${values.stt_preflight_overlap_ms}ms` : null,
          values.plan_ms ? `plan ${values.plan_ms}ms` : null,
          values.turn_total_ms ? `turn ${values.turn_total_ms}ms` : null,
        ].filter(Boolean).join(" / ") || "none";
      }

      function pickMimeType() {
        const options = ["audio/webm;codecs=opus", "audio/webm", "audio/mp4"];
        return options.find((type) => MediaRecorder.isTypeSupported(type)) || "";
      }

      function compactSettings(settings) {
        return [
          settings.sampleRate ? `${settings.sampleRate} Hz` : null,
          settings.channelCount ? `${settings.channelCount} ch` : null,
          settings.sampleSize ? `${settings.sampleSize} bit` : null,
          settings.echoCancellation !== undefined ? `EC ${settings.echoCancellation}` : null,
          settings.noiseSuppression !== undefined ? `NS ${settings.noiseSuppression}` : null,
          settings.autoGainControl !== undefined ? `AGC ${settings.autoGainControl}` : null,
          settings.latency !== undefined ? `lat ${settings.latency}` : null,
        ].filter(Boolean).join(" / ") || "unknown";
      }

      function downloadBlob(name, blob) {
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = name;
        link.click();
        URL.revokeObjectURL(url);
      }

      function jsonBlob(value) {
        return new Blob([JSON.stringify(value, null, 2)], { type: "application/json" });
      }

      function average(values) {
        return values.reduce((sum, value) => sum + value, 0) / Math.max(1, values.length);
      }

      function percentile(values, ratio) {
        if (values.length === 0) return 0;
        const sorted = [...values].sort((a, b) => a - b);
        const index = Math.min(sorted.length - 1, Math.max(0, Math.floor((sorted.length - 1) * ratio)));
        return sorted[index];
      }

      function round(value) {
        return Math.round(value * 1_000_000) / 1_000_000;
      }

      function roundOrNull(value) {
        return Number.isFinite(value) ? round(value) : null;
      }

      function safeCall(fn, fallback) {
        try {
          return fn();
        } catch {
          return fallback;
        }
      }

      function escapeHtml(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      els.refreshBtn.addEventListener("click", loadDevices);
      els.startBtn.addEventListener("click", () => start().catch((error) => {
        setState("error");
        log(error.message || String(error));
      }));
      els.stopBtn.addEventListener("click", () => stop().catch((error) => log(error.message || String(error))));
      els.exportSessionBtn.addEventListener("click", () => {
        downloadBlob("cua-mic-diagnostics-session.json", jsonBlob(exportableSession()));
      });
      els.copySessionBtn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(JSON.stringify(exportableSession(), null, 2));
        log("Copied session JSON.");
      });
      els.clearRunsBtn.addEventListener("click", () => {
        session.runs = [];
        renderRuns();
        log("Cleared diagnostic runs.");
      });

      if (!navigator.mediaDevices?.getUserMedia) {
        setState("unsupported");
        log("This browser does not expose getUserMedia.");
      } else {
        loadDevices().catch(() => log("Click Record run once to grant microphone permission, then refresh devices."));
      }
    </script>
  </body>
</html>

